ption":"2d deep blue\nPlate 2","capMulti":true,"inside":"2d","insidePrint":true},{"id":"d-mwcuamw5-c","type":"desc","x":2.5,"y":187.5,"w":150,"h":27,"text":"Rowland Hill's postal reform made a letter cost one penny anywhere in Britain, paid in advance by the sender. The Penny Black went on sale on 1 May 1840 and was valid from 6 May. Each stamp carries corner letters that show its place on the sheet of 240.","style":{"font":"EB Garamond","size":10,"bold":false,"italic":false,"underline":false,"smallCaps":false,"weight":400}},{"id":"a-mwcuamwe-i","type":"art","x":117.5,"y":143.75,"pic":"c_pennyblack","w":32,"h":38,"supporters":"none","ribbon":false,"motto":""},{"id":"t-mwcuamws-j","type":"text","x":33.75,"y":225,"text":"Printed by Perkins, Bacon & Petch\nPortrait after William Wyon's City Medal","style":{"font":"EB Garamond","size":9,"bold":false,"italic":true,"underline":false,"smallCaps":false,"weight":400},"w":90,"align":"center","lh":"normal","firstBold":false,"firstUnder":false}],"nextS":7,"frameLine":"dashed"}]}}